# Tag URLs that changed on 2026-09-10, when tag slugs replaced plain
# lowercasing so that multi-word tags stopped producing %20 in links.
# Keys are the decoded request path.
"/tags/browser extensions/"    "/tags/browser-extensions/"
"/tags/command line/"          "/tags/command-line/"
"/tags/cross-origin storage/"  "/tags/cross-origin-storage/"
"/tags/dark mode/"             "/tags/dark-mode/"
"/tags/home automation/"       "/tags/home-automation/"
"/tags/machine learning/"      "/tags/machine-learning/"
"/tags/microsoft edge/"        "/tags/microsoft-edge/"
"/tags/mini apps/"             "/tags/mini-apps/"
"/tags/node.js/"               "/tags/node-js/"
"/tags/open source/"           "/tags/open-source/"
"/tags/project fugu/"          "/tags/project-fugu/"
"/tags/semantic web/"          "/tags/semantic-web/"
"/tags/service workers/"       "/tags/service-workers/"
"/tags/transformers.js/"       "/tags/transformers-js/"
"/tags/web standards/"         "/tags/web-standards/"

# Tag pages that never should have existed (Eleventy collection names that
# leaked into the tag pagination); send them to the tag index.
"/tags/postsbyyear/"           "/tags/"
"/tags/postsbyyearmonth/"      "/tags/"
"/tags/postsbyyearmonthday/"   "/tags/"
